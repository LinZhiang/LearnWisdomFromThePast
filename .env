# 本地环境变量（修改后请重启 npm run dev）
# 请勿将含真实密钥的 .env 提交到 Git

# DeepSeek 密钥已迁至 server/.env，勿在此填写 API Key。
# 完整说明见：docs/ENV-说明.md

# 生产构建必填：已部署的 AI 代理根路径（须以 /v1 结尾，无尾部斜杠）
# VITE_AI_API_BASE=

# 可选：按场景指定 DeepSeek 模型（不填则用代码内默认值 deepseek-v4-flash）
# VITE_DEEPSEEK_MODEL_DEFAULT=deepseek-v4-flash
# VITE_DEEPSEEK_MODEL_HEAVY=deepseek-v4-flash
# VITE_DEEPSEEK_ALLOW_PRO=true
